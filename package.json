{
  "name": "markz-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "A beautiful, Markdown native Electron editor and SDK.",
  "author": "Markz",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:sdk": "vite build --config vite.sdk.config.ts && tsc -p tsconfig.sdk.json --emitDeclarationOnly",
    "preview": "electron-vite preview",
    "package": "pnpm build && electron-builder --win",
    "package:portable": "pnpm build && electron-builder --win --config electron-builder.portable.yml",
    "package:nsis": "pnpm build && electron-builder --win --config electron-builder.nsis.yml",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "ai:smoke": "node scripts/ai-desktop-smoke.mjs",
    "settings:smoke": "node scripts/settings-desktop-smoke.mjs",
    "sdk:smoke": "node scripts/sdk-dom-test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@phosphor-icons/react": "^2.1.7",
    "codemirror": "^6.0.1",
    "decode-named-character-reference": "^1.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
